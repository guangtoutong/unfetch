{
  "manifest_version": 3,
  "name": "unfetch 下载助手",
  "version": "0.3.0",
  "description": "拦截浏览器下载并自动嗅探网页 HLS (.m3u8) / 视频流，附带 Cookie 与 Referer 一键发送给 unfetch",
  "permissions": [
    "downloads",
    "storage",
    "contextMenus",
    "notifications",
    "alarms",
    "tabs",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1:19543/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "unfetch 下载助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
