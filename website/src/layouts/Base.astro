---
import { getStrings, LANGS } from '../i18n/strings'

interface Props {
  lang?: string
  pageTitle?: string
}
const { lang = 'en', pageTitle } = Astro.props
const s = getStrings(lang)
const title = pageTitle ? `${pageTitle} · unfetch` : s.meta.title

const currentPath = Astro.url.pathname
function langHref(code: string): string {
  const stripped = currentPath.replace(/^\/(zh|ja|ko|de|fr|es|pt|it|pl|nl|tr|sv|uk)(\/|$)/, '/')
  return code === 'en' ? stripped : `/${code}${stripped === '/' ? '' : stripped}`
}
const currentLang = LANGS.find((l) => l.code === lang) || LANGS[0]
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={s.meta.description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <style is:global>
    :root {
      /* 配色 v2 — 提高对比度。原版 --muted #94a3b8 在 #07071a 上虽然技术上
         过 WCAG AA,但实际偏紫的深底让灰蓝文本视觉上还是发糊。 */
      --bg: #0a0a1f;
      --bg-2: #161635;
      --bg-3: #1f1f40;
      --fg: #f1f3f9;
      --muted: #c2c8d6;
      --muted-strong: #d8dde8;
      --primary: #a78bfa;
      --primary-strong: #c4b5fd;
      --accent: #fcd34d;
      --border: rgba(255,255,255,0.16);
      --border-strong: rgba(255,255,255,0.24);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { background: var(--bg); color: var(--fg); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif; line-height: 1.6; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
    a { color: var(--primary); text-decoration: none; }
    a:hover { color: var(--primary-strong); }
    .container { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
    h1, h2, h3 { color: var(--fg); }
    /* 加宽 body 段落,muted 文本默认就走 muted-strong */
    p { color: var(--muted-strong); }

    .lang-btn { display: flex; align-items: center; gap: 4px; padding: 6px 10px; background: transparent; border: 1px solid transparent; border-radius: 6px; cursor: pointer; color: var(--muted); font: inherit; font-size: 13px; }
    .lang-btn:hover { background: rgba(255,255,255,0.05); color: var(--fg); }
    .lang-menu { position: absolute; right: 0; top: 36px; background: var(--bg-2); border: 1px solid var(--border); border-radius: 8px; padding: 4px; min-width: 170px; z-index: 100; max-height: 360px; overflow-y: auto; box-shadow: 0 8px 24px rgba(0,0,0,0.4); display: none; }
    .lang-menu.open { display: block; }
    .lang-menu a { display: block; padding: 7px 10px; border-radius: 5px; color: var(--fg); font-size: 13px; transition: background 0.15s; }
    .lang-menu a:hover { background: rgba(99,102,241,0.15); }
    .lang-menu a.active { color: var(--primary); background: rgba(99,102,241,0.12); font-weight: 600; }

    .stats-row { display: inline-flex; gap: 8px; margin-top: 18px; align-items: center; flex-wrap: wrap; justify-content: center; }
    .stats-row a { display: inline-flex; align-items: center; opacity: 0.85; transition: opacity 0.15s; }
    .stats-row a:hover { opacity: 1; }
    .stats-row img { display: block; }
  </style>
</head>
<body>
  <header style="border-bottom: 1px solid var(--border);">
    <div class="container" style="display: flex; align-items: center; justify-content: space-between; padding-top: 16px; padding-bottom: 16px;">
      <a href={lang === 'en' ? '/' : `/${lang}`} style="display: flex; align-items: center; gap: 10px; color: white;">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
          <defs>
            <linearGradient id="u-grad-h" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#a855f7" />
              <stop offset="100%" stop-color="#7c3aed" />
            </linearGradient>
            <linearGradient id="arr-grad-h" x1="0.5" y1="0" x2="0.5" y2="1">
              <stop offset="0%" stop-color="#fde047" />
              <stop offset="100%" stop-color="#f59e0b" />
            </linearGradient>
          </defs>
          <path d="M3 3 L3 13.5 Q3 19 12 19 Q21 19 21 13.5 L21 3 L17 3 L17 13.2 Q17 15.5 12 15.5 Q7 15.5 7 13.2 L7 3 Z" fill="url(#u-grad-h)" />
          <path d="M10 4 L14 4 L14 10.5 L17 10.5 L12 16 L7 10.5 L10 10.5 Z" fill="url(#arr-grad-h)" />
        </svg>
        <span style="font-weight: 700; font-size: 18px; letter-spacing: -0.5px;">unfetch</span>
      </a>
      <nav style="display: flex; align-items: center; gap: 16px; font-size: 14px;">
        <a href={lang === 'en' ? '/' : `/${lang}`} style="color: var(--muted-strong); font-weight: 500;">{s.nav.home}</a>
        <a href={(lang === 'en' ? '/' : `/${lang}/`) + '#download'} style="color: var(--muted-strong); font-weight: 500;">{s.nav.download}</a>
        <a href={lang === 'en' ? '/mcp' : `/${lang}/mcp`} style="color: var(--muted-strong); font-weight: 500;">{s.nav.mcp}</a>
        <a href={(lang === 'en' ? '/' : `/${lang}/`) + '#sponsor'} style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 11px; border-radius: 999px; border: 1px solid rgba(244,114,182,0.35); background: rgba(244,114,182,0.10); color: #f472b6; font-weight: 600;">
          <span style="color: #f472b6;">♥</span>{s.nav.sponsor}
        </a>
        <a href="https://github.com/guangtoutong/unfetch" style="color: var(--muted-strong); font-weight: 500;" target="_blank" rel="noreferrer">{s.nav.github}</a>

        <div id="lang-wrap" style="position: relative;">
          <button class="lang-btn" id="lang-btn" type="button">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <line x1="2" y1="12" x2="22" y2="12" />
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
            </svg>
            <span>{currentLang.native}</span>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="lang-menu" id="lang-menu">
            {LANGS.map((l) => (
              <a href={langHref(l.code)} class={l.code === lang ? 'active' : ''}>
                {l.native}
              </a>
            ))}
          </div>
        </div>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer style="border-top: 1px solid var(--border); padding: 32px 0; margin-top: 80px;">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center; font-size: 13px; color: var(--muted);">
      <span>{s.footer.copy}</span>
      <span><a href="https://github.com/guangtoutong/unfetch/blob/master/LICENSE">{s.footer.license}</a></span>
    </div>
  </footer>

  <script is:inline>
    // 语言切换器开关
    (function () {
      const btn = document.getElementById('lang-btn')
      const menu = document.getElementById('lang-menu')
      if (!btn || !menu) return
      btn.addEventListener('click', (e) => {
        e.stopPropagation()
        menu.classList.toggle('open')
      })
      document.addEventListener('click', (e) => {
        if (!menu.contains(e.target) && !btn.contains(e.target)) {
          menu.classList.remove('open')
        }
      })
    })()

    // Hero "Download" 按钮：默认 href 已是 macOS universal dmg。JS 探测 OS
    // 后，从按钮上的 data-{os}-href / data-{os}-text 属性读对应平台的链接和
    // 文案,把 href 换成 "Download for Windows" 这种完整短语,而不是 base + 后缀。
    // 模式参考 notebook/web 的 Hero.astro。
    // 前导 ; 防止上一个 IIFE 的 })() 后没分号导致两个 IIFE 被合并成函数调用。
    ;(function () {
      const btn = document.getElementById('download-cta')
      const label = document.getElementById('download-cta-label')
      if (!btn) return
      const ua = navigator.userAgent || ''
      const platform = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || ''
      let os = 'mac'
      if (/Win/i.test(ua) || /Windows/i.test(platform)) os = 'win'
      else if (/Linux/i.test(ua) && !/Android/i.test(ua)) os = 'linux'
      else if (/Mac|iPhone|iPad/i.test(ua) || /Mac/i.test(platform)) os = 'mac'
      const href = btn.getAttribute('data-' + os + '-href')
      const text = btn.getAttribute('data-' + os + '-text')
      if (href) btn.setAttribute('href', href)
      if (text && label) label.textContent = text
    })()
  </script>
</body>
</html>
