---
import { getStrings, LANGS } from '../i18n/strings'

interface Props {
  lang?: string
  pageTitle?: string
}
const { lang = 'en', pageTitle } = Astro.props
const s = getStrings(lang)
const title = pageTitle ? `${pageTitle} · unfetch` : s.meta.title

const currentPath = Astro.url.pathname
function langHref(code: string): string {
  // 把 /xx/... 或 /... 路径替换前缀
  const stripped = currentPath.replace(/^\/(zh|ja|ko|de|fr|es|pt|it|pl|nl|tr|sv|uk)(\/|$)/, '/')
  return code === 'en' ? stripped : `/${code}${stripped === '/' ? '' : stripped}`
}
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={s.meta.description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <style is:global>
    :root {
      --bg: #07071a;
      --bg-2: #0f0f24;
      --fg: #e5e7eb;
      --muted: #94a3b8;
      --primary: #8b5cf6;
      --accent: #fbbf24;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { background: var(--bg); color: var(--fg); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif; line-height: 1.5; }
    a { color: var(--primary); text-decoration: none; }
    a:hover { color: #a78bfa; }
    .container { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
  </style>
</head>
<body>
  <header style="border-bottom: 1px solid rgba(255,255,255,0.06);">
    <div class="container" style="display: flex; align-items: center; justify-content: space-between; padding-top: 16px; padding-bottom: 16px;">
      <a href={lang === 'en' ? '/' : `/${lang}`} style="display: flex; align-items: center; gap: 10px; color: white;">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
          <defs>
            <linearGradient id="u-grad-h" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#a855f7" />
              <stop offset="100%" stop-color="#7c3aed" />
            </linearGradient>
            <linearGradient id="arr-grad-h" x1="0.5" y1="0" x2="0.5" y2="1">
              <stop offset="0%" stop-color="#fde047" />
              <stop offset="100%" stop-color="#f59e0b" />
            </linearGradient>
          </defs>
          <path d="M3 3 L3 13.5 Q3 19 12 19 Q21 19 21 13.5 L21 3 L17 3 L17 13.2 Q17 15.5 12 15.5 Q7 15.5 7 13.2 L7 3 Z" fill="url(#u-grad-h)" />
          <path d="M10 4 L14 4 L14 10.5 L17 10.5 L12 16 L7 10.5 L10 10.5 Z" fill="url(#arr-grad-h)" />
        </svg>
        <span style="font-weight: 700; font-size: 18px; letter-spacing: -0.5px;">unfetch</span>
      </a>
      <nav style="display: flex; align-items: center; gap: 20px; font-size: 14px;">
        <a href={lang === 'en' ? '/' : `/${lang}`} style="color: var(--muted);">{s.nav.home}</a>
        <a href={lang === 'en' ? '/mcp' : `/${lang}/mcp`} style="color: var(--muted);">{s.nav.mcp}</a>
        <a href="https://github.com/guangtoutong/unfetch" style="color: var(--muted);" target="_blank" rel="noreferrer">{s.nav.github}</a>
        <details style="position: relative;">
          <summary style="cursor: pointer; color: var(--muted); list-style: none; padding: 4px 8px; border-radius: 6px;">
            🌐 {LANGS.find((l) => l.code === lang)?.native || 'English'} ▾
          </summary>
          <div style="position: absolute; right: 0; top: 28px; background: var(--bg-2); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 4px; min-width: 160px; z-index: 100; max-height: 360px; overflow-y: auto;">
            {LANGS.map((l) => (
              <a href={langHref(l.code)} style={`display: block; padding: 6px 10px; border-radius: 5px; color: ${l.code === lang ? 'var(--primary)' : 'var(--fg)'}; font-size: 12px;`}>
                {l.native}
              </a>
            ))}
          </div>
        </details>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer style="border-top: 1px solid rgba(255,255,255,0.06); padding: 32px 0; margin-top: 80px;">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center; font-size: 13px; color: var(--muted);">
      <span>{s.footer.copy}</span>
      <span><a href="https://github.com/guangtoutong/unfetch/blob/master/LICENSE">{s.footer.license}</a></span>
    </div>
  </footer>
</body>
</html>
